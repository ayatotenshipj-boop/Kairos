QMainWindow {
    background-color: #0f0f0f;
    color: #e0e0e0;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
}

#sidebar {
    background-color: #0a0a0a;
    border-right: 1px solid #1e1e1e;
}

#sidebarTitle {
    color: #888888;
}

#sidebarHeader {
    color: #888888;
}

#statusLabel {
    color: #888888;
}

#separator {
    color: #1e1e1e;
    max-height: 1px;
}

#dropZone {
    border: 1px dashed #333333;
    border-radius: 8px;
    padding: 20px;
    color: #555555;
}

#dropZoneActive {
    border: 1px dashed #4a9eff;
    border-radius: 8px;
    padding: 20px;
    color: #e0e0e0;
}

#dropZoneInvalid {
    border: 1px dashed #ff4a4a;
    border-radius: 8px;
    padding: 20px;
    color: #ff4a4a;
}

QPushButton {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    color: #e0e0e0;
    padding: 8px 16px;
    border-radius: 4px;
}

QPushButton:disabled {
    color: #555555;
    border-color: #1e1e1e;
}

QComboBox {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    color: #e0e0e0;
    padding: 4px 8px;
}

QDialog {
    background-color: #0f0f0f;
    color: #e0e0e0;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
}

QLabel {
    color: #e0e0e0;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
}

QLineEdit {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    color: #e0e0e0;
    padding: 4px 8px;
    border-radius: 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: #4a9eff;
}

QTextEdit {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    color: #e0e0e0;
    padding: 4px;
    border-radius: 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
}

QListWidget {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    color: #e0e0e0;
    padding: 4px;
    border-radius: 4px;
}

QListWidget::item {
    padding: 4px 8px;
}

QListWidget::item:selected {
    background-color: #1e3450;
    color: #e0e0e0;
}

QListWidget::item:hover {
    background-color: #1a2a3a;
}

QPushButton:hover {
    background-color: #222222;
    border-color: #4a9eff;
}

#configButton {
    background-color: transparent;
    border: 1px solid #1e1e1e;
    color: #888888;
    padding: 6px 12px;
    text-align: left;
}

#configButton:hover {
    border-color: #333333;
    color: #e0e0e0;
}

#saveButton {
    background-color: #1a2a3a;
    border-color: #4a9eff;
    color: #4a9eff;
}

#saveButton:hover {
    background-color: #1f3548;
}
